<MudAppBar Color="Color.Primary" Fixed="true" Dense="true">
    <MudLink Typo="Typo.h5" Class="mr-4" Href="" Color="Color.Inherit" Underline="Underline.None">CthulhuSheets</MudLink>
    <MudSpacer />
    <MudTooltip Text="Your Investigators">
        <MudIconButton Icon="@Icons.Material.Filled.RecentActors" Color="Color.Inherit"
                       OnClick="OnOpenRoster" />
    </MudTooltip>
    <MudTooltip Text="Create New Character">
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Inherit"
                       OnClick="OnCreateNewCharacter" Class="ml-2" />
    </MudTooltip>
    <MudFileUpload T="IBrowserFile" FilesChanged="HandleFileSelected" Accept=".json" Class="ml-2">
        <CustomContent>
            <MudTooltip Text="Upload Character">
                <MudIconButton Icon="@Icons.Material.Filled.FileUpload" Color="Color.Inherit"
                               OnClick="@context.OpenFilePickerAsync" />
            </MudTooltip>
        </CustomContent>
        <SelectedTemplate />
    </MudFileUpload>
    <MudTooltip Text="Download Active Character">
        <MudIconButton Icon="@Icons.Material.Filled.FileDownload" Color="Color.Inherit"
                       OnClick="OnFileDownload" Class="ml-2" />
    </MudTooltip>
</MudAppBar>
