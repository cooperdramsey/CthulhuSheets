<aside class="sheet-sidebar">
    <div class="sidebar-identity">
        <MudText Typo="Typo.h6">@Investigator.Name</MudText>
        @if (!string.IsNullOrWhiteSpace(Investigator.Occupation))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Investigator.Occupation</MudText>
        }
    </div>

    <PortraitUpload @bind-PortraitDataUrl="Investigator.PortraitDataUrl"
                    PortraitSize="128"
                    ShowRemoveButton="false"
                    PlaceholderIcon="@Icons.Material.Filled.Person"
                    PlaceholderText=""
                    OnChanged="PersistAsync" />

    <div class="sidebar-pools">
        <div class="pool-item">
            <div class="pool-label">
                <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Small" Color="Color.Error" />
                <MudText Typo="Typo.overline">Hit Points</MudText>
            </div>
            <div class="pool-inputs">
                <MudNumericField T="int?"
                                 @bind-Value="Investigator.HitPoints.Current"
                                 @bind-Value:after="PersistAsync"
                                 Placeholder="Cur"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 HideSpinButtons="true"
                                 Class="pool-input" />
                <span class="pool-sep">/</span>
                <MudNumericField T="int?"
                                 @bind-Value="Investigator.HitPoints.Max"
                                 @bind-Value:after="PersistAsync"
                                 Placeholder="Max"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 HideSpinButtons="true"
                                 Class="pool-input" />
            </div>
        </div>
        <div class="pool-item">
            <div class="pool-label">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Color="Color.Secondary" />
                <MudText Typo="Typo.overline">Magic Points</MudText>
            </div>
            <div class="pool-inputs">
                <MudNumericField T="int?"
                                 @bind-Value="Investigator.MagicPoints.Current"
                                 @bind-Value:after="PersistAsync"
                                 Placeholder="Cur"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 HideSpinButtons="true"
                                 Class="pool-input" />
                <span class="pool-sep">/</span>
                <MudNumericField T="int?"
                                 @bind-Value="Investigator.MagicPoints.Max"
                                 @bind-Value:after="PersistAsync"
                                 Placeholder="Max"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 HideSpinButtons="true"
                                 Class="pool-input" />
            </div>
        </div>
        <div class="pool-item">
            <div class="pool-label">
                <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Color="Color.Info" />
                <MudText Typo="Typo.overline">Sanity</MudText>
                <div class="luck-roll-actions">
                    <RollButton Size="Size.Small"
                                Color="Color.Primary"
                                OnRoll="mod => RollSanity(mod)" />
                    @if (_sanityRoll.HasValue)
                    {
                        <span class="luck-roll-result">@_sanityRoll</span>
                        @if (SanitySuccess is true)
                        {
                            <MudTooltip Text="Passed — take the lower SAN loss">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                            </MudTooltip>
                        }
                        else if (SanitySuccess is false)
                        {
                            <MudTooltip Text="Failed — take the higher SAN loss">
                                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" />
                            </MudTooltip>
                        }
                    }
                </div>
            </div>
            <div class="pool-inputs">
                <MudNumericField T="int?"
                                 @bind-Value="Investigator.Sanity.Current"
                                 @bind-Value:after="PersistAsync"
                                 Label="Cur"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 HideSpinButtons="true"
                                 Class="pool-input" />
                <span class="pool-sep">/</span>
                <MudNumericField T="int?"
                                 @bind-Value="Investigator.Sanity.Starting"
                                 @bind-Value:after="PersistAsync"
                                 Label="Start"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 HideSpinButtons="true"
                                 Class="pool-input" />
                <span class="pool-sep">/</span>
                <MudTooltip Text="@($"Maximum Sanity = 99 − Cthulhu Mythos ({CthulhuMythos}%). Sanity can never be restored above this value.")">
                    <MudNumericField T="int?"
                                     Value="@SanMax"
                                     ReadOnly="true"
                                     Label="Max"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HideSpinButtons="true"
                                     Class="pool-input" />
                </MudTooltip>
            </div>
            <div class="sanity-thresholds">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Bout triggers:</MudText>
                <MudTooltip Text="Lose 5 or more Sanity from a single source → make an INT roll; success means a bout of madness (temporary insanity, 1D10 hours).">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">Temporary: 5+ from one source</MudChip>
                </MudTooltip>
                <MudTooltip Text="@($"Lose ⅕ or more of current Sanity ({(IndefiniteLoss?.ToString() ?? "—")}) within a single day → indefinitely insane until cured.")">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error">Indefinite: lose @(IndefiniteLoss?.ToString() ?? "—")+ in a day</MudChip>
                </MudTooltip>
                <MudTooltip Text="Sanity reduced to 0 → permanently insane; the investigator is retired from play.">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">Permanent: 0</MudChip>
                </MudTooltip>
            </div>
        </div>
        <div class="pool-item">
            <div class="pool-label">
                <MudText Typo="Typo.overline">Luck</MudText>
                <div class="luck-roll-actions">
                    <RollButton Size="Size.Small"
                                Color="Color.Primary"
                                OnRoll="mod => RollLuck(mod)" />
                    @if (_luckRoll.HasValue)
                    {
                        <span class="luck-roll-result">@_luckRoll</span>
                        @if (LuckSuccess is true)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                        }
                        else if (LuckSuccess is false)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" />
                        }
                    }
                </div>
            </div>
            <MudNumericField T="int?"
                             @bind-Value="Investigator.Luck.Current"
                             @bind-Value:after="PersistAsync"
                             Placeholder="Current"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             HideSpinButtons="true" />
        </div>
    </div>

    <MudDivider />

    <div class="sidebar-conditions">
        <MudText Typo="Typo.overline">Conditions</MudText>
        <div class="condition-list">
            <MudCheckBox @bind-Value="Investigator.TemporaryInsanity"
                         @bind-Value:after="PersistAsync"
                         Label="Temp. Insanity"
                         Color="Color.Error"
                         Size="Size.Small" />
            <MudCheckBox @bind-Value="Investigator.IndefiniteInsanity"
                         @bind-Value:after="PersistAsync"
                         Label="Indef. Insanity"
                         Color="Color.Error"
                         Size="Size.Small" />
            <MudCheckBox @bind-Value="Investigator.MajorWound"
                         @bind-Value:after="PersistAsync"
                         Label="Major Wound"
                         Color="Color.Error"
                         Size="Size.Small" />
            <MudCheckBox @bind-Value="Investigator.Unconscious"
                         @bind-Value:after="PersistAsync"
                         Label="Unconscious"
                         Color="Color.Error"
                         Size="Size.Small" />
            <MudCheckBox @bind-Value="Investigator.Dying"
                         @bind-Value:after="PersistAsync"
                         Label="Dying"
                         Color="Color.Error"
                         Size="Size.Small" />
        </div>
    </div>

    <MudDivider />

    <div class="sidebar-stats">
        <MudText Typo="Typo.overline">Other Stats</MudText>
        @if (StatsEditMode)
        {
            <MudNumericField T="int?"
                             @bind-Value="Investigator.MovementRate"
                             @bind-Value:after="PersistAsync"
                             Label="Movement Rate"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             HideSpinButtons="true" />
            <MudNumericField T="int?"
                             @bind-Value="Investigator.Build"
                             @bind-Value:after="PersistAsync"
                             Label="Build"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             HideSpinButtons="true" />
            <MudTextField T="string"
                          @bind-Value="Investigator.DamageBonus"
                          @bind-Value:after="PersistAsync"
                          Label="Damage Bonus"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        }
        else
        {
            <div class="stat-row">
                <span class="stat-label-icon">
                    <MudIcon Icon="@Icons.Material.Filled.DirectionsRun" Size="Size.Small" Color="Color.Warning" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Movement Rate</MudText>
                </span>
                <MudText Typo="Typo.body2">@(Investigator.MovementRate ?? 0)</MudText>
            </div>
            <div class="stat-row">
                <span class="stat-label-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Build</MudText>
                </span>
                <MudText Typo="Typo.body2">@(Investigator.Build ?? 0)</MudText>
            </div>
            <div class="stat-row">
                <span class="stat-label-icon">
                    <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Small" Color="Color.Tertiary" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Damage Bonus</MudText>
                </span>
                <MudText Typo="Typo.body2">@(Investigator.DamageBonus ?? "—")</MudText>
            </div>
        }
    </div>
</aside>
