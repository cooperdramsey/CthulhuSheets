<div class="combat-container">
    <div class="combat-stats-bar">
        <div class="combat-stat-chip">
            <div class="combat-stat-label">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Build</MudText>
            </div>
            <MudText Typo="Typo.h5" Class="combat-stat-value">@(Investigator.Build?.ToString() ?? "—")</MudText>
        </div>
        <div class="combat-stat-chip">
            <div class="combat-stat-label">
                <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Small" Color="Color.Tertiary" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Damage Bonus</MudText>
            </div>
            <MudText Typo="Typo.h5" Class="combat-stat-value">@(Investigator.DamageBonus ?? "—")</MudText>
        </div>
        <div class="combat-stat-chip">
            <div class="combat-stat-label">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsRun" Size="Size.Small" Color="Color.Warning" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Move</MudText>
            </div>
            <MudText Typo="Typo.h5" Class="combat-stat-value">@(Investigator.MovementRate?.ToString() ?? "—")</MudText>
            @if (Investigator.MovementDistancePerRound is int dist)
            {
                <span class="combat-move-distance">@dist yds/round</span>
            }
        </div>
        <div class="combat-stat-chip combat-stat-chip--dodge">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Dodge</MudText>
            <div class="combat-dodge-row">
                <div class="combat-dodge-tier">
                    <span class="combat-dodge-num">@(DodgeRegular?.ToString() ?? "—")</span>
                    <ThresholdCheckIcon Roll="_dodgeRoll" Threshold="DodgeRegular" Class="roll-check-icon" />
                    <span class="combat-dodge-label">Reg</span>
                </div>
                <span class="combat-dodge-sep">/</span>
                <div class="combat-dodge-tier">
                    <span class="combat-dodge-num">@(DodgeHard?.ToString() ?? "—")</span>
                    <ThresholdCheckIcon Roll="_dodgeRoll" Threshold="DodgeHard" Class="roll-check-icon" />
                    <span class="combat-dodge-label">Half</span>
                </div>
                <span class="combat-dodge-sep">/</span>
                <div class="combat-dodge-tier">
                    <span class="combat-dodge-num">@(DodgeExtreme?.ToString() ?? "—")</span>
                    <ThresholdCheckIcon Roll="_dodgeRoll" Threshold="DodgeExtreme" Class="roll-check-icon" />
                    <span class="combat-dodge-label">Fifth</span>
                </div>
            </div>
            <div class="roll-action">
                <RollButton Size="Size.Small"
                            Color="Color.Primary"
                            OnRoll="mod => RollDodge(mod)" />
                <span class="roll-result">@(_dodgeRoll?.ToString() ?? "")</span>
            </div>
        </div>
    </div>
    <div class="combat-weapons-section">
        <div class="combat-weapons-header">
            <MudText Typo="Typo.h6">Weapons</MudText>
            <div class="combat-weapons-header-actions">
                @if (_weaponsEditMode)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="AddWeapon" />
                }
                <MudTooltip Text="@(_weaponsEditMode ? "Done Editing" : "Edit Weapons")">
                    <MudIconButton Icon="@(_weaponsEditMode ? Icons.Material.Filled.EditOff : Icons.Material.Filled.Edit)"
                                   Color="@(_weaponsEditMode ? Color.Primary : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="ToggleWeaponsEditMode" />
                </MudTooltip>
            </div>
        </div>
        @if (Investigator.Weapons.Count == 0 && !_weaponsEditMode)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="weapons-empty-hint">
                No weapons — tap Edit to add one.
            </MudText>
        }
        else
        {
            <div class="weapon-grid @(_weaponsEditMode ? "weapon-grid--edit" : "")">
                <span class="weapon-col-header">Name</span>
                <span class="weapon-col-header weapon-col-center">Regular</span>
                <span class="weapon-col-header weapon-col-center">Half</span>
                <span class="weapon-col-header weapon-col-center">Fifth</span>
                <span></span>
                <span class="weapon-col-header">Damage</span>
                <span class="weapon-col-header weapon-col-center">Atk/Rnd</span>
                <span class="weapon-col-header">Range</span>
                <span class="weapon-col-header weapon-col-center">Mag Size</span>
                <span class="weapon-col-header weapon-col-center">Malf</span>
                <span></span>
                @foreach (var weapon in Investigator.Weapons)
                {
                    var hasRoll = _weaponRolls.TryGetValue(weapon, out var weaponRoll);
                    @if (_weaponsEditMode)
                    {
                        <MudTextField @bind-Value="weapon.Name"
                                      @bind-Value:after="PersistAsync"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="Name" />
                        <div class="weapon-skill-cell">
                            @if (LinkedSkill(weapon) is Skill linkedSkill)
                            {
                                <MudTooltip Text="@($"Linked to {linkedSkill.Name} — value follows the Skills tab")">
                                    <span class="weapon-derived-val">@linkedSkill.EffectiveRegular</span>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudNumericField T="int?"
                                                 @bind-Value="weapon.SkillRegular"
                                                 @bind-Value:after="PersistAsync"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 HideSpinButtons="true"
                                                 Placeholder="—" />
                            }
                            <MudTooltip Text="Link this weapon to a skill">
                            <MudMenu Icon="@(weapon.SkillName is null ? Icons.Material.Filled.LinkOff : Icons.Material.Filled.Link)"
                                     Size="Size.Small"
                                     Dense="true"
                                     MaxHeight="300"
                                     AnchorOrigin="Origin.BottomLeft">
                                <MudMenuItem OnClick="() => LinkWeaponSkill(weapon, null)">Manual value</MudMenuItem>
                                @foreach (var sheetSkill in Investigator.Skills.Where(s => !string.IsNullOrWhiteSpace(s.Name)).OrderBy(s => s.Name))
                                {
                                    <MudMenuItem OnClick="() => LinkWeaponSkill(weapon, sheetSkill.Name)">
                                        @sheetSkill.Name (@sheetSkill.EffectiveRegular)
                                    </MudMenuItem>
                                }
                            </MudMenu>
                            </MudTooltip>
                        </div>
                        <div class="weapon-derived-val">@(WeaponSkillHalf(weapon)?.ToString() ?? "—")</div>
                        <div class="weapon-derived-val">@(WeaponSkillFifth(weapon)?.ToString() ?? "—")</div>
                        <span></span>
                        <MudTextField @bind-Value="weapon.Damage"
                                      @bind-Value:after="PersistAsync"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="e.g. 1d6+db" />
                        <MudNumericField T="int?"
                                         @bind-Value="weapon.NumberOfAttacks"
                                         @bind-Value:after="PersistAsync"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                        <MudTextField @bind-Value="weapon.Range"
                                      @bind-Value:after="PersistAsync"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Placeholder="e.g. Touch" />
                        <MudNumericField T="int?"
                                         @bind-Value="weapon.Ammo"
                                         @bind-Value:after="PersistAsync"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                        <MudNumericField T="int?"
                                         @bind-Value="weapon.Malfunction"
                                         @bind-Value:after="PersistAsync"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="() => RemoveWeapon(weapon)" />
                    }
                    else
                    {
                        <div class="weapon-plain-val">@(string.IsNullOrWhiteSpace(weapon.Name) ? "—" : weapon.Name)</div>
                        <div class="weapon-val-cell">
                            <span class="weapon-val--regular">@(WeaponSkillValue(weapon)?.ToString() ?? "—")</span>
                            <ThresholdCheckIcon Roll="@(hasRoll ? weaponRoll : (int?)null)" Threshold="WeaponSkillValue(weapon)" Class="roll-check-icon" PlaceholderClass="weapon-roll-icon-placeholder" />
                        </div>
                        <div class="weapon-val-cell">
                            <span class="weapon-derived-val">@(WeaponSkillHalf(weapon)?.ToString() ?? "—")</span>
                            <ThresholdCheckIcon Roll="@(hasRoll ? weaponRoll : (int?)null)" Threshold="WeaponSkillHalf(weapon)" Class="roll-check-icon" PlaceholderClass="weapon-roll-icon-placeholder" />
                        </div>
                        <div class="weapon-val-cell">
                            <span class="weapon-derived-val">@(WeaponSkillFifth(weapon)?.ToString() ?? "—")</span>
                            <ThresholdCheckIcon Roll="@(hasRoll ? weaponRoll : (int?)null)" Threshold="WeaponSkillFifth(weapon)" Class="roll-check-icon" PlaceholderClass="weapon-roll-icon-placeholder" />
                        </div>
                        <div class="weapon-roll-cell">
                            <RollButton Size="Size.Small"
                                        Color="Color.Primary"
                                        OnRoll="async mod => await RollWeapon(weapon, mod)" />
                            @if (hasRoll)
                            {
                                <span class="weapon-roll-result @(WeaponSkillValue(weapon) is int wSkill2 ? (weaponRoll <= wSkill2 ? "success" : "fail") : "")">
                                    @weaponRoll
                                </span>
                            }
                        </div>
                        <div class="weapon-plain-val">@(weapon.Damage ?? "—")</div>
                        <div class="weapon-plain-val weapon-col-center">@(weapon.NumberOfAttacks?.ToString() ?? "—")</div>
                        <div class="weapon-plain-val">@(weapon.Range ?? "—")</div>
                        <div class="weapon-plain-val weapon-col-center">@(weapon.Ammo?.ToString() ?? "—")</div>
                        <div class="weapon-plain-val weapon-col-center">@(weapon.Malfunction?.ToString() ?? "—")</div>
                        <span></span>
                    }
                }
            </div>
        }
    </div>

    <div class="combat-reference-section">
        <MudText Typo="Typo.h6">Combat Reference</MudText>
        <MudExpansionPanels MultiExpansion="true" Class="combat-reference-panels">
            <MudExpansionPanel Text="Combat Round">
                <div class="combat-reference-content">
                    <div class="combat-reference-grid">
                        <div class="combat-reference-card">
                            <MudText Typo="Typo.subtitle2">Turn order</MudText>
                            <ul class="combat-reference-list">
                                <li>Act in DEX order, highest first; break ties with the higher combat skill.</li>
                                <li>Each combatant acts once per round. Some monsters make multiple attacks on their turn.</li>
                                <li>You may delay to act later; simultaneous delayers still resolve by DEX.</li>
                            </ul>
                        </div>
                        <div class="combat-reference-card">
                            <MudText Typo="Typo.subtitle2">Actions</MudText>
                            <ul class="combat-reference-list">
                                <li>Attack, attempt a fighting maneuver, flee, cast a spell, or take another timed action.</li>
                                <li>Combat rolls cannot be pushed; the next attempt is simply your next attack.</li>
                                <li>Use your action to flee when you have a route and are not restrained.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </MudExpansionPanel>

            <MudExpansionPanel Text="Melee &amp; Maneuvers">
                <div class="combat-reference-content">
                    <div class="combat-reference-grid">
                        <div class="combat-reference-card">
                            <MudText Typo="Typo.subtitle2">Opposed melee</MudText>
                            <ul class="combat-reference-list">
                                <li><strong>Fight back:</strong> compare Fighting successes. The higher result deals damage; a tie goes to the attacker.</li>
                                <li><strong>Dodge:</strong> compare Fighting to Dodge. The attacker needs the higher result; a tie goes to the defender.</li>
                                <li>After a defender has fought back or dodged once in a round, further melee attacks against them gain one bonus die.</li>
                            </ul>
                        </div>
                        <div class="combat-reference-card">
                            <MudText Typo="Typo.subtitle2">Damage &amp; maneuvers</MudText>
                            <ul class="combat-reference-list">
                                <li>Unarmed damage is 1D3. Armor reduces damage that passes through it.</li>
                                <li>On your turn, an Extreme success maximizes damage; impaling weapons also add one rolled weapon-damage die.</li>
                                <li>For a maneuver, state a definite goal and compare Build first: one or two lower gives one or two penalty dice; three lower is impossible.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </MudExpansionPanel>

            <MudExpansionPanel Text="Firearms">
                <div class="combat-reference-content">
                    <div class="combat-reference-grid">
                        <div class="combat-reference-card">
                            <MudText Typo="Typo.subtitle2">Attack &amp; range</MudText>
                            <ul class="combat-reference-list">
                                <li>Roll Firearms; the attack is not opposed, and a failed roll deals no damage.</li>
                                <li>Within base range: Regular. Up to twice base range: Hard. Up to four times base range: Extreme.</li>
                                <li>At very long range, an impale requires a critical success (01). Readied firearms act at DEX + 50.</li>
                            </ul>
                        </div>
                        <div class="combat-reference-card">
                            <MudText Typo="Typo.subtitle2">Common modifiers</MudText>
                            <div class="combat-reference-modifiers">
                                <div>
                                    <span class="combat-reference-modifier-label combat-reference-modifier-label--bonus">Bonus die</span>
                                    <span>Aim for one round, point-blank range, or a large target (Build 4+).</span>
                                </div>
                                <div>
                                    <span class="combat-reference-modifier-label combat-reference-modifier-label--penalty">Penalty die</span>
                                    <span>Diving for cover, 50%+ concealment, fast/small targets, firing into melee, multiple handgun shots, or loading and firing.</span>
                                </div>
                            </div>
                        </div>
                        <div class="combat-reference-card">
                            <MudText Typo="Typo.subtitle2">Aiming &amp; cover</MudText>
                            <ul class="combat-reference-list">
                                <li>Aim on your turn to fire next round with one bonus die. Moving or taking damage loses the aim.</li>
                                <li>A successful dive-for-cover Dodge gives the shooter one penalty die; the diver forfeits their next attack.</li>
                                <li>Firing into melee has one penalty die. On a fumble, the shot hits an ally instead.</li>
                            </ul>
                        </div>
                        <div class="combat-reference-card">
                            <MudText Typo="Typo.subtitle2">Reloading &amp; malfunctions</MudText>
                            <ul class="combat-reference-list">
                                <li>Load two shells in one round, swap a clip in one round, or load an MG belt in two rounds.</li>
                                <li>2–3 handgun shots in a round each take one penalty die.</li>
                                <li>A roll at or above the weapon's malfunction number means it does not fire.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </MudExpansionPanel>

            <MudExpansionPanel Text="Automatic Fire">
                <div class="automatic-fire-reference">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        A volley contains up to one tenth of the relevant SMG or MG skill, rounded down, with a minimum of three bullets.
                    </MudText>

                    <div class="automatic-fire-inputs">
                        <MudNumericField T="int"
                                         Value="_automaticFireSkill"
                                         ValueChanged="OnAutomaticFireSkillChanged"
                                         Label="SMG/MG skill"
                                         Min="0"
                                         Max="99"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                        <MudNumericField T="int"
                                         Value="_automaticFireBullets"
                                         ValueChanged="OnAutomaticFireBulletsChanged"
                                         Label="Bullets in volley"
                                         Min="1"
                                         Max="@AutomaticFireVolleyLimit"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                        <MudNumericField T="int"
                                         Value="_automaticFireVolleyNumber"
                                         ValueChanged="OnAutomaticFireVolleyNumberChanged"
                                         Label="Volley number"
                                         Min="1"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                    </div>

                    <div class="automatic-fire-results">
                        <div class="automatic-fire-result">
                            <span class="automatic-fire-result-label">Maximum volley</span>
                            <strong>@AutomaticFireVolleyLimit bullets</strong>
                        </div>
                        <div class="automatic-fire-result">
                            <span class="automatic-fire-result-label">Regular success</span>
                            <strong>@AutomaticFireRegularHits hit@(AutomaticFireRegularHits == 1 ? string.Empty : "s")</strong>
                        </div>
                        <div class="automatic-fire-result">
                            <span class="automatic-fire-result-label">Extreme success</span>
                            <strong>All @_automaticFireBullets hit; first half impale</strong>
                        </div>
                        <div class="automatic-fire-result">
                            <span class="automatic-fire-result-label">Roll modifier</span>
                            @if (AutomaticFirePenaltyDice > 0)
                            {
                                <strong>@AutomaticFirePenaltyDice penalty die@(AutomaticFirePenaltyDice == 1 ? string.Empty : "ce")</strong>
                            }
                            else
                            {
                                <strong>Normal firearms roll</strong>
                            }
                        </div>
                        @if (AutomaticFireDifficultyIncreases > 0)
                        {
                            <div class="automatic-fire-result automatic-fire-result--warning">
                                <span class="automatic-fire-result-label">Difficulty</span>
                                <strong>Raise @AutomaticFireDifficultyIncreases step@(AutomaticFireDifficultyIncreases == 1 ? string.Empty : "s")</strong>
                            </div>
                        }
                    </div>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        One trigger pull per round; declare bullets up to the weapon's capacity. First volley: normal firearms roll. Each later volley adds a penalty die (maximum two); every volley after that raises the difficulty one step. Make a fresh roll for each volley or new target. A burst is one volley of 2–3 bullets. If the attack's difficulty is already Extreme, an Extreme success hits but does not impale.
                    </MudText>
                </div>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </div>
</div>
