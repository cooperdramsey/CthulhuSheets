<div class="skills-container">
    @if (!string.IsNullOrWhiteSpace(Investigator.Occupation))
    {
        <div class="skills-occupation-header">
            <MudIcon Icon="@Icons.Material.Filled.Work" Size="Size.Small" Color="Color.Secondary" />
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Investigator.Occupation</MudText>
            @if (Investigator.Skills.Any(s => s.IsOccupationSkill))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="skills-occ-legend">
                    ★ occupation skill
                </MudText>
            }
        </div>
    }
    <div class="skills-toolbar">
        <MudTextField @bind-Value="_skillFilter"
                      Placeholder="Filter skills..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="skills-filter"
                      Immediate="true"
                      Clearable="true" />
        <MudMenu Icon="@Icons.Material.Filled.Sort"
                 Color="@(_sortMode == SortMode.Alpha ? Color.Default : Color.Primary)"
                 Size="Size.Small"
                 Dense="true"
                 AnchorOrigin="Origin.BottomLeft"
                 Title="Sort skills">
            <MudMenuItem OnClick="@(() => _sortMode = SortMode.Alpha)">
                <div class="skill-sort-item @(_sortMode == SortMode.Alpha ? "skill-sort-item--active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.SortByAlpha" Size="Size.Small" />
                    A → Z
                </div>
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => _sortMode = SortMode.RegularDesc)">
                <div class="skill-sort-item @(_sortMode == SortMode.RegularDesc ? "skill-sort-item--active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardDoubleArrowDown" Size="Size.Small" />
                    Highest value first
                </div>
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => _sortMode = SortMode.RegularAsc)">
                <div class="skill-sort-item @(_sortMode == SortMode.RegularAsc ? "skill-sort-item--active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardDoubleArrowUp" Size="Size.Small" />
                    Lowest value first
                </div>
            </MudMenuItem>
        </MudMenu>
        <MudNumericField T="int?"
                         @bind-Value="_minRegular"
                         Placeholder="Min ≥"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Min="0"
                         Max="100"
                         HideSpinButtons="true"
                         Class="skills-min-filter" />
        @if (_skillsEditMode)
        {
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.FormatListBulleted"
                       OnClick="LoadDefaultSkills">
                Load Defaults
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="AddSkill" />
        }
        @if (!_skillsEditMode && Investigator.Skills.Any(s => s.HasExperienceCheck))
        {
            <MudTooltip Text="Roll d100 per checked skill. Roll over current value to gain +1D10.">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.TrendingUp"
                           Color="Color.Success"
                           OnClick="ImproveSkills">
                    Improve Skills
                </MudButton>
            </MudTooltip>
        }
        <MudTooltip Text="@(_skillsEditMode ? "Done Editing" : "Edit Skills")">
            <MudIconButton Icon="@(_skillsEditMode ? Icons.Material.Filled.EditOff : Icons.Material.Filled.Edit)"
                           Color="@(_skillsEditMode ? Color.Primary : Color.Default)"
                           Size="Size.Small"
                           OnClick="() => _skillsEditMode = !_skillsEditMode" />
        </MudTooltip>
    </div>
    @if (_improvementResults.Count > 0)
    {
        <div class="skill-improvement-results">
            <div class="skill-improvement-header">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Skill Improvement Results</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               OnClick="() => _improvementResults.Clear()" />
            </div>
            @foreach (var result in _improvementResults)
            {
                <div class="skill-improvement-row @(result.Improved ? "improved" : "no-change")">
                    <span class="skill-improvement-name">@result.SkillName</span>
                    @if (result.Improved)
                    {
                        <span>rolled @result.Roll vs @result.OldValue → <strong>+@(result.NewValue - result.OldValue)</strong> (now @result.NewValue)</span>
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Success" />
                    }
                    else
                    {
                        <span>rolled @result.Roll vs @result.OldValue → no improvement</span>
                        <MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Color="Color.Secondary" />
                    }
                </div>
            }
        </div>
    }
    @{
        var skillList = VisibleSkills.ToList();
        var half = (skillList.Count + 1) / 2;
        var leftSkills = skillList.Take(half).ToList();
        var rightSkills = skillList.Skip(half).ToList();
    }
    @if (skillList.Count > 0)
    {
        <div class="skill-columns">
            @foreach (var columnSkills in new[] { leftSkills, rightSkills })
            {
                <div class="skill-grid @(_skillsEditMode ? "skill-grid--edit" : "")">
                    <span class="skill-col-header">Skill</span>
                    <span class="skill-col-header skill-col-center">Base</span>
                    <span class="skill-col-header skill-col-center">Regular</span>
                    <span class="skill-col-header skill-col-center">Half</span>
                    <span class="skill-col-header skill-col-center">Fifth</span>
                    <span></span>
                    @foreach (var skill in columnSkills)
                    {
                        var hasSkillRoll = _lastSkillRolls.TryGetValue(skill, out var skillRoll);
                        @if (_skillsEditMode)
                        {
                            <MudTextField @bind-Value="skill.Name"
                                          @bind-Value:after="PersistAsync"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                            <MudNumericField T="int"
                                             @bind-Value="skill.BaseValue"
                                             @bind-Value:after="PersistAsync"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true" />
                            <MudNumericField T="int?"
                                             @bind-Value="skill.Regular"
                                             @bind-Value:after="PersistAsync"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true" />
                            <div class="skill-derived-val">@(skill.Half?.ToString() ?? "—")</div>
                            <div class="skill-derived-val">@(skill.Fifth?.ToString() ?? "—")</div>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => RemoveSkill(skill)" />
                        }
                        else
                        {
                            <div class="skill-name-val">
                                @if (!NonImprovableSkills.Contains(skill.Name))
                                {
                                    <MudTooltip Text="@(skill.HasExperienceCheck ? "Clear experience check" : "Mark for experience check")">
                                        <input type="checkbox"
                                               class="skill-exp-check"
                                               checked="@skill.HasExperienceCheck"
                                               @onchange="async e => { skill.HasExperienceCheck = (bool)e.Value!; await PersistAsync(); }" />
                                    </MudTooltip>
                                }
                                @(string.IsNullOrWhiteSpace(skill.Name) ? "—" : skill.Name)
                                @if (skill.IsOccupationSkill)
                                {
                                    <MudTooltip Text="Occupation skill">
                                        <span class="skill-occ-star">★</span>
                                    </MudTooltip>
                                }
                            </div>
                            <div class="skill-val">@skill.BaseValue</div>
                            <div class="skill-val-cell">
                                <span class="skill-val skill-val--regular">@skill.EffectiveRegular</span>
                                @if (hasSkillRoll)
                                {
                                    <MudIcon Icon="@(skillRoll <= skill.EffectiveRegular ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                             Color="@(skillRoll <= skill.EffectiveRegular ? Color.Success : Color.Error)"
                                             Size="Size.Small"
                                             Class="char-check-icon" />
                                }
                                else { <span class="skill-roll-icon-placeholder"></span> }
                            </div>
                            <div class="skill-val-cell">
                                <span class="skill-derived-val">@(skill.Half?.ToString() ?? "—")</span>
                                @if (hasSkillRoll && skill.Half.HasValue)
                                {
                                    <MudIcon Icon="@(skillRoll <= skill.Half.Value ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                             Color="@(skillRoll <= skill.Half.Value ? Color.Success : Color.Error)"
                                             Size="Size.Small"
                                             Class="char-check-icon" />
                                }
                                else { <span class="skill-roll-icon-placeholder"></span> }
                            </div>
                            <div class="skill-val-cell">
                                <span class="skill-derived-val">@(skill.Fifth?.ToString() ?? "—")</span>
                                @if (hasSkillRoll && skill.Fifth.HasValue)
                                {
                                    <MudIcon Icon="@(skillRoll <= skill.Fifth.Value ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                             Color="@(skillRoll <= skill.Fifth.Value ? Color.Success : Color.Error)"
                                             Size="Size.Small"
                                             Class="char-check-icon" />
                                }
                                else { <span class="skill-roll-icon-placeholder"></span> }
                            </div>
                            <div class="skill-roll-cell">
                                <RollButton Size="Size.Small"
                                            Color="Color.Primary"
                                            OnRoll="async mod => await RollSkill(skill, mod)" />
                                <span class="skill-roll-result">@(hasSkillRoll ? skillRoll.ToString() : "")</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
</div>
