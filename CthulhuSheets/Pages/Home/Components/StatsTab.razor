<div class="stats-container">
    <div class="char-grid">
        @foreach (var (label, stat) in CharacteristicList)
        {
            var isEditing = _editingStatName == stat.Name;
            <MudCard Elevation="1" Class="char-card">
                <MudCardContent Class="char-card-content">
                    <div class="char-header">
                        <div class="char-title-row">
                            <div class="char-title-left">
                                @if (!isEditing)
                                {
                                    <RollButton Size="Size.Small"
                                                Color="Color.Primary"
                                                OnRoll="mod => RollStat(stat, mod)" />
                                    @if (_lastRolls.TryGetValue(stat.Name, out var lastRoll))
                                    {
                                        <span class="char-roll-result">@lastRoll</span>
                                    }
                                }
                            </div>
                            <MudText Typo="Typo.h4" Class="char-abbr">@stat.Name</MudText>
                            <div class="char-title-actions">
                                <MudTooltip Text="@(isEditing ? "Done" : "Edit")">
                                    <MudIconButton Icon="@(isEditing ? Icons.Material.Filled.EditOff : Icons.Material.Filled.Edit)"
                                                   Color="@(isEditing ? Color.Primary : Color.Default)"
                                                   Size="Size.Small"
                                                   OnClick="() => ToggleEditStat(stat.Name)" />
                                </MudTooltip>
                            </div>
                        </div>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@label</MudText>
                    </div>
                    <MudDivider Class="my-2" />
                    @if (isEditing)
                    {
                        <MudNumericField T="int?"
                                         @bind-Value="stat.Regular"
                                         @bind-Value:after="OnCharacteristicChanged"
                                         Label="Regular"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                        <div class="char-edit-derived">
                            <div class="char-value-row">
                                <span class="char-value-label">Half</span>
                                <span class="char-value-num">@(stat.Half?.ToString() ?? "—")</span>
                            </div>
                            <div class="char-value-row">
                                <span class="char-value-label">Fifth</span>
                                <span class="char-value-num">@(stat.Fifth?.ToString() ?? "—")</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="char-value-row">
                            <span class="char-value-label">Regular</span>
                            <span class="char-value-right">
                                <span class="char-value-num">@(stat.Regular?.ToString() ?? "—")</span>
                                <ThresholdCheckIcon Roll="LastRoll(stat.Name)" Threshold="stat.Regular" Class="char-check-icon" PlaceholderClass="char-check-placeholder" />
                            </span>
                        </div>
                        <div class="char-value-row">
                            <span class="char-value-label">Half</span>
                            <span class="char-value-right">
                                <span class="char-value-num">@(stat.Half?.ToString() ?? "—")</span>
                                <ThresholdCheckIcon Roll="LastRoll(stat.Name)" Threshold="stat.Half" Class="char-check-icon" PlaceholderClass="char-check-placeholder" />
                            </span>
                        </div>
                        <div class="char-value-row">
                            <span class="char-value-label">Fifth</span>
                            <span class="char-value-right">
                                <span class="char-value-num">@(stat.Fifth?.ToString() ?? "—")</span>
                                <ThresholdCheckIcon Roll="LastRoll(stat.Name)" Threshold="stat.Fifth" Class="char-check-icon" PlaceholderClass="char-check-placeholder" />
                            </span>
                        </div>
                    }
                </MudCardContent>
            </MudCard>
        }
    </div>
</div>
