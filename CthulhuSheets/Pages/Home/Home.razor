@page "/"

@if (InvestigatorService.Current is not null)
{
    <PageTitle>@(string.IsNullOrWhiteSpace(InvestigatorService.Current.Name) ? "Unnamed Investigator" : InvestigatorService.Current.Name)</PageTitle>
}
else
{
    <PageTitle>Home</PageTitle>
}

@if (InvestigatorService.Current is not null)
{
    <InvestigatorSheet Investigator="@InvestigatorService.Current" />
    <DiceFab />
}
