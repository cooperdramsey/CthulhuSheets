@using CthulhuSheets.Helpers

<div class="characteristics-step">

    <div class="characteristics-header">
        <div>
            <MudText Typo="Typo.h5">Characteristics</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                Select a generation method and roll or assign your investigator's core characteristics, then apply age modifiers.
            </MudText>
        </div>
    </div>

    @* ── Method selector ──────────────────────────────── *@
    <div class="method-selector">
        <MudToggleGroup T="CreationMethod"
                        Value="_method"
                        ValueChanged="ChangeMethod"
                        SelectionMode="SelectionMode.SingleSelection"
                        Color="Color.Primary"
                        CheckMark="true"
                        Disabled="BaseLocked">
            <MudToggleItem Value="CreationMethod.Roll" Text="Roll (dice)" />
            <MudToggleItem Value="CreationMethod.PlaceRolls" Text="Place Rolls" />
            <MudToggleItem Value="CreationMethod.PointBuy" Text="Point Buy" />
            <MudToggleItem Value="CreationMethod.QuickFire" Text="Quick Fire" />
        </MudToggleGroup>

        <MudSwitch T="bool"
                   Value="_humanPotentialEnabled"
                   ValueChanged="OnHumanPotentialToggled"
                   Color="Color.Secondary"
                   Disabled="_ageApplied"
                   Label="Human Potential (+1D10)" />
    </div>

    @* ── Method toolbar (bulk actions / counters / help) ── *@
    <div class="method-toolbar">
        @switch (_method)
        {
            case CreationMethod.Roll:
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Casino"
                           Disabled="BaseLocked"
                           OnClick="RollAll">
                    @(AllStatsRolled ? "Reroll All" : "Roll All")
                </MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Roll each characteristic (3D6 × 5, or (2D6+6) × 5 for SIZ / INT / EDU).
                </MudText>
                break;

            case CreationMethod.PlaceRolls:
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Casino"
                           Disabled="BaseLocked"
                           OnClick="RollPlacePool">
                    @(_dice.Count == 0 ? "Roll Pool" : "Reroll Pool")
                </MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Roll a pool of eight values, then drag each one onto a characteristic
                    (recommended minimum 40 for INT and SIZ).
                </MudText>
                break;

            case CreationMethod.PointBuy:
                <MudChip T="string"
                         Size="Size.Medium"
                         Color="@(PointBuyRemaining == 0 ? Color.Success : PointBuyRemaining < 0 ? Color.Error : Color.Warning)">
                    @PointBuyRemaining / @CharacteristicHelper.PointBuyTotal remaining
                </MudChip>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Distribute @CharacteristicHelper.PointBuyTotal points; each characteristic
                    @CharacteristicHelper.PointBuyMin–@CharacteristicHelper.PointBuyMax
                    (recommended minimum 40 for INT and SIZ).
                </MudText>
                break;

            case CreationMethod.QuickFire:
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           Disabled="BaseLocked"
                           OnClick="ResetDiceToPool">
                    Clear
                </MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Drag the fixed set @string.Join(", ", CharacteristicHelper.QuickFireArray) — one value per characteristic.
                </MudText>
                break;
        }
    </div>

    @* ── Pool of draggable values (Place Rolls / Quick Fire) ── *@
    @if (IsAssignmentMethod)
    {
        <div class="assign-pool-wrap">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @if (_dice.Count == 0)
                {
                    @("Roll the pool to get values to assign.")
                }
                else if (_method == CreationMethod.PlaceRolls)
                {
                    @("Drag a value onto a characteristic below. Values range 15–90.")
                }
                else
                {
                    @("Drag a value onto a characteristic below.")
                }
            </MudText>
            <div class="assign-pool-zone"
                 @ondragover:preventDefault="true"
                 @ondrop="@(() => DropOnZone(PoolZone))">
                @foreach (var die in PooledDice)
                {
                    var d = die;
                    <div class="pool-die"
                         draggable="@(BaseLocked ? "false" : "true")"
                         @ondragstart="@(() => OnDragStart(d))">
                        @d.Value
                    </div>
                }
            </div>
        </div>
    }

    @* ── Characteristic grid ──────────────────────────── *@
    <div class="characteristics-grid">
        @foreach (var def in _characteristicDefs)
        {
            var stat = def.Stat;
            <div class="char-card">
                <div class="char-card-top">
                    <span class="char-abbr">@stat.Name</span>
                    <span class="char-fullname">@def.FullName</span>
                    @if (_method == CreationMethod.Roll)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="char-formula-chip">@def.Formula</MudChip>
                    }
                </div>

                @if (_method == CreationMethod.PointBuy)
                {
                    <MudNumericField T="int?"
                                     Value="stat.Regular"
                                     ValueChanged="@(v => OnPointBuyChanged(stat, v))"
                                     Min="CharacteristicHelper.PointBuyMin"
                                     Max="CharacteristicHelper.PointBuyMax"
                                     Disabled="BaseLocked"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HideSpinButtons="true"
                                     Class="char-input" />
                }
                else if (IsAssignmentMethod)
                {
                    var assigned = AssignedDie(stat.Name);
                    <div class="char-drop-zone @(assigned is null ? "empty" : "")"
                         @ondragover:preventDefault="true"
                         @ondrop="@(() => DropOnZone(stat.Name))">
                        @if (assigned is not null)
                        {
                            var a = assigned;
                            <div class="pool-die"
                                 draggable="@(BaseLocked ? "false" : "true")"
                                 @ondragstart="@(() => OnDragStart(a))">
                                @a.Value
                            </div>
                        }
                        else
                        {
                            <span class="drop-hint">drop</span>
                        }
                    </div>
                }
                else
                {
                    <div class="char-value">
                        @(stat.Regular.HasValue ? stat.Regular.Value.ToString() : "—")
                    </div>
                }

                @if (stat.Regular.HasValue)
                {
                    <div class="char-derived">
                        <span>½&nbsp;@stat.Half</span>
                        <span>⅕&nbsp;@stat.Fifth</span>
                    </div>
                }
                else
                {
                    <div class="char-derived-placeholder"></div>
                }

                @if (_method == CreationMethod.Roll)
                {
                    <MudTooltip Text="@($"Roll {stat.Name}")">
                        <MudIconButton Icon="@Icons.Material.Filled.Casino"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       Disabled="BaseLocked"
                                       OnClick="@(() => RollSingle(def))" />
                    </MudTooltip>
                }
            </div>
        }

        @* ── Luck card ─────────────────────────────────── *@
        <div class="char-card">
            <div class="char-card-top">
                <span class="char-abbr">Luck</span>
                @if (_method == CreationMethod.Roll)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="char-formula-chip">3D6 × 5</MudChip>
                }
            </div>
            <div class="char-value">
                @(Investigator.Luck.Current.HasValue ? Investigator.Luck.Current.Value.ToString() : "—")
            </div>
            <div class="char-derived-placeholder"></div>
        </div>
    </div>

    @* ── Roll add-ons (Start Over / Modify Low Rolls) ──── *@
    @if (_method == CreationMethod.Roll && !BaseLocked && AllStatsRolled)
    {
        @if (CanStartOver)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                Three or more characteristics started below 50 — the Keeper may let you start over (use Reroll All).
            </MudAlert>
        }

        @if (CanModifyLowRolls)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                <div class="lowroll-alert">
                    <span>Three or more rolls are very low (under 10 before ×5). You may roll 1D6 and spread the extra among them.</span>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Casino"
                               OnClick="StartModifyLowRolls">
                        Modify Low Rolls
                    </MudButton>
                </div>
            </MudAlert>
        }

        @if (_lowRollPending)
        {
            <div class="distribute-panel">
                <div class="distribute-header">
                    <MudText Typo="Typo.subtitle2">Distribute @_lowRollPool points (+5 each)</MudText>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(LowRollRemaining == 0 ? Color.Success : LowRollRemaining < 0 ? Color.Error : Color.Warning)">
                        @LowRollRemaining remaining
                    </MudChip>
                </div>
                <div class="distribute-inputs">
                    @foreach (var target in _lowRollTargets)
                    {
                        var t = target;
                        var stat = GetCharacteristicByName(t);
                        <MudNumericField T="int"
                                         Value="_lowRollAlloc[t]"
                                         ValueChanged="@(v => OnLowRollAllocChanged(t, v))"
                                         Label="@t"
                                         Adornment="Adornment.End"
                                         AdornmentText="@($"= {stat.Regular}")"
                                         Min="0"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                    }
                </div>
                <div class="distribute-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(LowRollRemaining != 0)"
                               OnClick="ConfirmModifyLowRolls">
                        Confirm
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CancelModifyLowRolls">Cancel</MudButton>
                </div>
            </div>
        }
    }

    @* ── Human Potential add-on ───────────────────────── *@
    @if (_humanPotentialEnabled && BaseStatsReady && !_ageApplied)
    {
        <div class="distribute-panel human-potential">
            <MudText Typo="Typo.h6">Human Potential</MudText>

            @if (_humanPotentialApplied)
            {
                <div class="distribute-actions">
                    <MudText Typo="Typo.body2" Color="Color.Success">
                        Bonus of @_hpPool points applied.
                    </MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Undo"
                               OnClick="ResetHumanPotential">
                        Reset Bonus
                    </MudButton>
                </div>
            }
            else if (_hpRolled)
            {
                <div class="distribute-header">
                    <MudText Typo="Typo.subtitle2">Distribute @_hpPool bonus points (max 99 per characteristic)</MudText>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(HumanPotentialRemaining == 0 ? Color.Success : HumanPotentialRemaining < 0 ? Color.Error : Color.Warning)">
                        @HumanPotentialRemaining remaining
                    </MudChip>
                </div>
                <div class="distribute-inputs">
                    @foreach (var def in _characteristicDefs)
                    {
                        var stat = def.Stat;
                        var name = stat.Name;
                        <MudNumericField T="int"
                                         Value="_hpAlloc[name]"
                                         ValueChanged="@(v => OnHpAllocChanged(name, v))"
                                         Label="@name"
                                         Adornment="Adornment.End"
                                         AdornmentText="@($"= {(stat.Regular ?? 0) + _hpAlloc[name]}")"
                                         Min="0"
                                         Max="@(CharacteristicHelper.HumanPotentialMax - (stat.Regular ?? 0))"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                    }
                </div>
                <div class="distribute-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(HumanPotentialRemaining != 0)"
                               OnClick="ConfirmHumanPotential">
                        Confirm Bonus
                    </MudButton>
                </div>
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Casino"
                           OnClick="RollHumanPotential">
                    Roll 1D10 Bonus
                </MudButton>
            }
        </div>
    }

    @* ── Age Section ────────────────────────────────── *@
    <div class="age-section">
        <MudText Typo="Typo.h6">Age</MudText>

        <div class="age-input-row">
            <MudNumericField T="int?"
                             Value="_selectedAge"
                             ValueChanged="OnAgeChanged"
                             Label="Investigator Age"
                             Min="15" Max="90"
                             Variant="Variant.Outlined"
                             Disabled="_ageApplied"
                             HideSpinButtons="true"
                             Class="age-input" />
            @if (_currentBracket is not null && !_ageApplied && StatsReady)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="ApplyAgeModifiers">
                    Apply
                </MudButton>
            }
            @if (_ageApplied && !_deductionsPending)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Undo"
                           OnClick="ResetAgeModifiers">
                    Reset
                </MudButton>
            }
        </div>

        @if (!StatsReady && _selectedAge.HasValue && _currentBracket is not null && !_ageApplied)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">
                Finish generating all characteristics before applying age modifiers.
            </MudText>
        }

        @if (_currentBracket is not null && !_ageApplied)
        {
            <div class="age-effects">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                    Age bracket @_currentBracket.Label effects:
                </MudText>
                <ul class="age-effects-list">
                    @AgeBracketEffects(_currentBracket)
                </ul>
            </div>
        }

        @* ── All-bands reference ────────────────────────── *@
        <MudExpansionPanels Elevation="0" Class="age-reference-panels">
            <MudExpansionPanel Text="All age bands reference" Dense="true">
                <div class="age-reference-table">
                    @foreach (var bracket in AllBrackets)
                    {
                        <div class="age-reference-row">
                            <span class="age-reference-label">@bracket.Label</span>
                            <ul class="age-effects-list">
                                @AgeBracketEffects(bracket)
                            </ul>
                        </div>
                    }
                </div>
            </MudExpansionPanel>
        </MudExpansionPanels>

        @if (_deductionsPending)
        {
            <div class="age-deductions">
                <div class="deduction-header">
                    <MudText Typo="Typo.subtitle2">
                        Distribute @_deductionPool points of deductions
                    </MudText>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(DeductionsRemaining == 0 ? Color.Success : DeductionsRemaining < 0 ? Color.Error : Color.Warning)">
                        @DeductionsRemaining remaining
                    </MudChip>
                </div>
                <div class="deduction-inputs">
                    @foreach (var target in _deductionTargets)
                    {
                        var t = target;
                        var stat = GetCharacteristicByName(t);
                        <MudNumericField T="int"
                                         Value="_deductions[t]"
                                         ValueChanged="@(v => OnDeductionChanged(t, v))"
                                         Label="@t"
                                         Adornment="Adornment.End"
                                         AdornmentText="@($"/ {stat.Regular}")"
                                         Min="0"
                                         Max="@(stat.Regular ?? 0)"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HideSpinButtons="true" />
                    }
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(DeductionsRemaining != 0)"
                           OnClick="ConfirmDeductions">
                    Confirm Deductions
                </MudButton>
            </div>
        }

        @if (_ageLog.Count > 0)
        {
            <div class="age-log">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Results</MudText>
                @foreach (var entry in _ageLog)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">• @entry</MudText>
                }
            </div>
        }
    </div>

    @* ── Derived Attributes ───────────────────────────── *@
    @if (DerivedReady)
    {
        <div class="derived-section">
            <MudText Typo="Typo.h6">Derived Attributes</MudText>
            <div class="derived-grid">
                <div class="derived-card">
                    <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Medium" Color="Color.Info" />
                    <span class="derived-label">Sanity</span>
                    <span class="derived-value">@Investigator.Sanity.Starting</span>
                    <span class="derived-hint">= POW</span>
                </div>
                <div class="derived-card">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Medium" Color="Color.Secondary" />
                    <span class="derived-label">Magic Points</span>
                    <span class="derived-value">@Investigator.MagicPoints.Max</span>
                    <span class="derived-hint">= POW / 5</span>
                </div>
                <div class="derived-card">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Medium" Color="Color.Error" />
                    <span class="derived-label">Hit Points</span>
                    <span class="derived-value">@Investigator.HitPoints.Max</span>
                    <span class="derived-hint">= (SIZ + CON) / 10</span>
                </div>
                <div class="derived-card">
                    <MudIcon Icon="@Icons.Material.Filled.DirectionsRun" Size="Size.Medium" Color="Color.Warning" />
                    <span class="derived-label">Movement Rate</span>
                    <span class="derived-value">@Investigator.MovementRate</span>
                    <span class="derived-hint">STR/DEX vs SIZ ± age</span>
                </div>
                <div class="derived-card">
                    <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Medium" Color="Color.Tertiary" />
                    <span class="derived-label">Damage Bonus</span>
                    <span class="derived-value">@Investigator.DamageBonus</span>
                    <span class="derived-hint">STR + SIZ table</span>
                </div>
                <div class="derived-card">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Medium" Color="Color.Primary" />
                    <span class="derived-label">Build</span>
                    <span class="derived-value">@Investigator.Build</span>
                    <span class="derived-hint">STR + SIZ table</span>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private RenderFragment AgeBracketEffects(AgeBracket bracket) =>
        @<ul class="age-effects-list">
            @if (bracket.EduFlat != 0)
            {
                <li>Deduct @Math.Abs(bracket.EduFlat) from EDU</li>
            }
            @if (bracket.EduChecks > 0)
            {
                <li>@bracket.EduChecks EDU improvement check@(bracket.EduChecks > 1 ? "s" : "")</li>
            }
            @if (bracket.PhysicalDeduction > 0)
            {
                <li>Deduct @bracket.PhysicalDeduction points among @string.Join(", ", bracket.PhysicalTargets)</li>
            }
            @if (bracket.AppReduction > 0)
            {
                <li>Reduce APP by @bracket.AppReduction</li>
            }
            @if (bracket.DoubleLuck)
            {
                <li>Roll Luck twice, use higher value</li>
            }
        </ul>;
}
