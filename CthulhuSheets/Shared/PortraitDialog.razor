<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Set Portrait</MudText>
    </TitleContent>
    <DialogContent>
        <div class="portrait-dialog-body">

            <div class="portrait-dialog-preview">
                @if (!string.IsNullOrEmpty(_candidate))
                {
                    <img src="@_candidate" class="portrait-dialog-img" alt="Portrait preview" />
                }
                else
                {
                    <div class="portrait-dialog-placeholder">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size:4rem;opacity:0.2;" />
                    </div>
                }
            </div>

            <div class="portrait-dialog-inputs">
                <div class="portrait-dialog-file-row">
                    <label class="portrait-dialog-file-label mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-ripple">
                        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Class="mr-2" />
                        @(_fileName ?? "Choose File…")
                        <InputFile @key="_fileInputKey" OnChange="HandleFileSelected" accept="image/*" style="display:none" />
                    </label>
                    @if (!string.IsNullOrEmpty(_fileError))
                    {
                        <MudText Color="Color.Error" Typo="Typo.caption" Class="mt-1">@_fileError</MudText>
                    }
                </div>

                <MudText Typo="Typo.caption" Color="Color.Secondary">or paste an image URL</MudText>

                <MudTextField T="string"
                              Value="@_urlText"
                              ValueChanged="HandleUrlChanged"
                              Placeholder="https://example.com/image.jpg"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              FullWidth="true"
                              Immediate="true"
                              Error="@(!string.IsNullOrEmpty(_urlError))"
                              ErrorText="@_urlError"
                              OnKeyUp="HandleUrlKeyUp" />
            </div>

        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        @if (!string.IsNullOrEmpty(InitialValue))
        {
            <MudButton OnClick="Remove" Color="Color.Error" Variant="Variant.Text">Remove</MudButton>
        }
        <MudButton OnClick="Save"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@string.IsNullOrEmpty(_candidate)">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>
